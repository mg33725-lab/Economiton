# ==============================================================
# CONFIGURACIÓN DE ECONOMITIN (BOT DE GASTOS WHATSAPP)
# ==============================================================

# Puerto local del servidor
PORT=3000

# 1. IA GOOGLE GEMINI (GRATIS)
# Obtené tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. WHATSAPP CLOUD API (META FOR DEVELOPERS)
# Token temporal o permanente de WhatsApp Cloud API
WHATSAPP_TOKEN=tu_token_de_acceso_de_meta

# ID del número de teléfono asignado por Meta (lo ves en el panel de WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Token que inventás vos para validar el Webhook con Meta (debe coincidir con el que ponés en el panel de Meta)
WEBHOOK_VERIFY_TOKEN=economitin_token_secreto_2026

# 3. IDENTIFICACIÓN DE USUARIOS (Tus teléfonos y nombres)
# Formato internacional sin símbolos (ejemplo Argentina: 54911xxxxxxxx o 5493492xxxxxx)
PHONE_USER_1=5493492123456
NAME_USER_1=Juan

PHONE_USER_2=5493492654321
NAME_USER_2=Belén

# 4. GOOGLE SHEETS (OPCIONAL - Si se deja vacío, guarda todo en gastos.csv local)
# ID de la planilla (está en la URL: docs.google.com/spreadsheets/d/ESTE_ID_LARGO/edit)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
